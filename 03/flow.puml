@startuml
start
:**iload_1**
//i// 压入 //slot 1//
栈：[5];
:**iload_2**
//grain// 压入 //slot 2//
栈：[5, 4];
:**iadd**
弹出 5 和 4，压回 9
栈：[9];
:**iconst_1**
压入常量 //1//
栈：[9, 1];
:**isub**
栈：[8]（第一个子表达式完成）;
:**iload_2**
再一次将 //grain// 压栈
栈：[8, 4];
:**iconst_1**
栈：[8, 4, 1]（此时达到栈深的峰值 //stack=3//）;
:**isub**
栈：[8, 3]（第二个子表达式完成）;
:**iconst_m1**
压入 //-1//
栈：[8, 3, -1];
:**ixor**
栈：[8, -4]（//-4// 就是 //~3//）;
:**iand**
栈：[8];
:**ireturn**
返回 //8//，帧弹出，方法结束;
stop
@enduml

