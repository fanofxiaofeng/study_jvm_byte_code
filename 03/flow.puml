@startuml
start
:[0] //iload_1//
从 //slot 1// 读取 //i// 并压栈
栈：[5];
note right
  本图以 //i = 5// 为例进行说明
end note
:[1] //iload_2//
从 //slot 2// 读取 //grain// 并压栈
栈：[5, 4];
note right
  本图以 //grain = 4// 为例进行说明
end note
:[2] //iadd//
弹出 5 和 4，压回 9
栈：[9];
:[3] //iconst_1//
压入常量 //1//
栈：[9, 1];
:[4] //isub//
栈：[8]（第一个子表达式完成）;
:[5] //iload_2//
再一次将 //grain// 压栈
栈：[8, 4];
:[6] //iconst_1//
栈：[8, 4, 1]（此时达到栈深的峰值 //stack=3//）;
:[7] //isub//
栈：[8, 3]（第二个子表达式完成）;
:[8] //iconst_m1//
压入 //-1//
栈：[8, 3, -1];
:[9] //ixor//
栈：[8, -4]（//-4// 就是 //~3//）;
:[10] //iand//
栈：[8];
:[11] //ireturn//
返回 //8//，帧弹出，方法结束;
stop
@enduml
